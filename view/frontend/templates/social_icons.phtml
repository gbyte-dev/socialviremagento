<script type="text/javascript">
    require(['jquery', 'mage/url'], function($, urlBuilder){
        if (window.socialShareJsLoaded) return;
        window.socialShareJsLoaded = true; 

        $(document).ready(function() {
            $('#close-share-bar').on('click', function() {
                $('#social-share-floating-wrapper').fadeOut();
            });
            
            var currentUrl = window.location.href;
            var pageTitle = document.title;
            
            $('.share-btn').on('click', function(e) {
                e.preventDefault();
                var network = $(this).data('network');
                var shareUrl = '';
                var isCopy = $(this).hasClass('copy-link');
                var action = isCopy ? 'copy' : 'share';
                
                var encodedUrl = encodeURIComponent(currentUrl);
                var encodedTitle = encodeURIComponent(pageTitle);

                $.ajax({
                    url: urlBuilder.build('socialshare/index/track'),
                    type: 'POST',
                    data: {
                        platform: network || 'copy',
                        action: action,
                        page_url: currentUrl,
                        entity_type: '<?= $escaper->escapeJs($currentProduct ? "product" : "cms_page") ?>',
                        entity_id: '<?= $escaper->escapeJs($currentProduct ? $currentProduct->getId() : "") ?>',
                        entity_name: '<?= $escaper->escapeJs($currentProduct ? addslashes($currentProduct->getName()) : "Page") ?>'
                    }
                });

                if (isCopy) {
                    navigator.clipboard.writeText(currentUrl).then(function() {
                        alert('Link copied to clipboard!');
                    });
                    return;
                }

                switch(network) {
                    case 'facebook': shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodedUrl; break;
                    case 'twitter': shareUrl = 'https://twitter.com/intent/tweet?url=' + encodedUrl + '&text=' + encodedTitle; break;
                    case 'linkedin': shareUrl = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodedUrl; break;
                    case 'pinterest': shareUrl = 'https://pinterest.com/pin/create/button/?url=' + encodedUrl + '&media=&description=' + encodedTitle; break;
                    case 'telegram': shareUrl = 'https://t.me/share/url?url=' + encodedUrl + '&text=' + encodedTitle; break;
                    case 'whatsapp': shareUrl = 'https://api.whatsapp.com/send?text=' + encodedTitle + '%20' + encodedUrl; break;
                }

                if (shareUrl) {
                    window.open(shareUrl, '_blank', 'width=600,height=500,scrollbars=yes');
                }
            });
        });
    });
</script>
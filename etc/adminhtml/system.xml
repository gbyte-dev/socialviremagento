<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="socialshare" translate="label" type="text" sortOrder="500" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Social Share Settings</label>
            <tab>general</tab>
            <resource>MyVendor_SocialShare::config</resource> 
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Configuration</label>
                
                <field id="enabled" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Module</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="size" translate="label" type="select" sortOrder="6" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Icon Size</label>
                    <source_model>MyVendor\SocialShare\Model\Config\Source\Size</source_model>
                </field>

                <field id="animation" translate="label" type="select" sortOrder="7" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hover Animation</label>
                    <source_model>MyVendor\SocialShare\Model\Config\Source\Animation</source_model>
                </field>

                <field id="show_close_btn" translate="label" type="select" sortOrder="8" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Close Button on Floating Bar</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                
                <field id="style" translate="label" type="select" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Icon Shape</label>
                    <source_model>MyVendor\SocialShare\Model\Config\Source\Shape</source_model> <!-- Circle / Square -->
                </field>

                <field id="direction" translate="label" type="select" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Floating Position</label>
                    <source_model>MyVendor\SocialShare\Model\Config\Source\Direction</source_model> <!-- Left / Right -->
                </field>

                <field id="platforms" translate="label" type="multiselect" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Select Platforms</label>
                    <source_model>MyVendor\SocialShare\Model\Config\Source\Platforms</source_model>
                </field>

                <field id="show_on_product" translate="label" type="select" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show below Product Add to Cart</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>